{
  "name": "Mochi",
  "short": "mochi",
  "description": "Another monitor theme inspired by komari-web-mochi — six views, price tags, and a remaining-value module.",
  "version": "1.2.2",
  "author": "Mochi for monitor",
  "url": "https://github.com/kingshot101/monitor-theme-mochi",
  "config": [
    { "type": "title", "label": "外观" },
    {
      "key": "default_view",
      "type": "select",
      "label": "默认视图",
      "default": "modern",
      "options": [
        { "value": "modern", "label": "现代 Modern" },
        { "value": "compact", "label": "紧凑 Compact" },
        { "value": "classic", "label": "经典 Classic" },
        { "value": "detailed", "label": "详细 Detailed" },
        { "value": "task", "label": "网络 Task" },
        { "value": "earth", "label": "地球 Earth" }
      ]
    },
    {
      "key": "theme_mode",
      "type": "select",
      "label": "默认配色",
      "default": "system",
      "options": [
        { "value": "system", "label": "跟随系统" },
        { "value": "light", "label": "亮色" },
        { "value": "dark", "label": "暗色" }
      ]
    },
    {
      "key": "accent",
      "type": "select",
      "label": "强调色",
      "default": "gold",
      "options": [
        { "value": "gold", "label": "琥珀金（默认·运河夜景）" },
        { "value": "blue", "label": "海蓝" },
        { "value": "purple", "label": "堇紫" },
        { "value": "green", "label": "松绿" },
        { "value": "pink", "label": "樱粉（Mochi）" }
      ]
    },
    {
      "key": "default_lang",
      "type": "select",
      "label": "默认语言",
      "default": "zh-CN",
      "options": [
        { "value": "zh-CN", "label": "简体中文" },
        { "value": "en", "label": "English" }
      ]
    },
    { "type": "title", "label": "剩余价值模块" },
    {
      "key": "show_value_module",
      "type": "boolean",
      "label": "显示剩余价值模块",
      "default": true,
      "help": "节点卡片上的价格按钮、悬浮窗与总览入口"
    },
    {
      "key": "default_currency",
      "type": "text",
      "label": "默认货币",
      "default": "CNY",
      "help": "节点未设置货币、访客也未补录时使用，如 CNY / USD"
    },
    { "type": "title", "label": "页面" },
    {
      "key": "icon_url",
      "type": "text",
      "label": "网站图标（ICON）",
      "default": "",
      "help": "填图片地址（https://…/logo.png 或 .ico / .svg），留空用主题默认图标"
    },
    {
      "key": "notice",
      "type": "text",
      "label": "公告",
      "default": "",
      "help": "显示在页面顶部，留空不显示"
    },
    {
      "key": "footer_text",
      "type": "text",
      "label": "页脚文本",
      "default": "",
      "help": "留空显示默认页脚"
    }
  ]
}
