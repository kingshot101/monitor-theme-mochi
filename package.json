{
  "name": "monitor-theme-mochi",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Mochi — a monitor status page theme inspired by komari-web-mochi, with a remaining-value module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-texture.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "mock": "node mock/server.mjs",
    "pack:theme": "npm run build && bash scripts/build-theme.sh",
    "shots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "globe.gl": "^2.34.0",
    "i18next": "^24.2.2",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.50.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "ws": "^8.18.0"
  }
}
